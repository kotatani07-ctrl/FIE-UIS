# Local development only. Replace credentials with managed secrets in production.
DJANGO_ENV=development
# Kosongkan di lokal: dev.py membuat kunci acak. Wajib diisi (>=50 karakter) di produksi.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=postgres://fie_local:local-only-password@db:5432/fie_local
POSTGRES_DB=fie_local
POSTGRES_USER=fie_local
POSTGRES_PASSWORD=local-only-password
FRONTEND_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080
ADMIN_URL_PREFIX=kelola-lokal/
TURNSTILE_SECRET_KEY=
CONTACT_NOTIFICATION_EMAIL=
CONTACT_IP_HASH_KEY=
SECURITY_CONTACT=
DEFAULT_FROM_EMAIL=
REDIS_URL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
