# Copy to the project root .env for local development only.
DJANGO_ENV=development
# Kosongkan di lokal: dev.py membuat kunci acak. Wajib diisi (>=50 karakter) di produksi.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=postgres://fie_local:local-only-password@db:5432/fie_local
FRONTEND_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080
ADMIN_URL_PREFIX=kelola-lokal/
TURNSTILE_SECRET_KEY=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles
